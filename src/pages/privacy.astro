---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const lastUpdated = 'March 7, 2026';

type Run = { text: string; bold?: boolean; href?: string };
type Block =
  | { type: 'para'; runs: Run[] }
  | { type: 'cross' | 'check'; items: string[] }
  | { type: 'steps'; items: string[] }
  | { type: 'cards'; items: [string, string][] };

const t = (text: string): Run => ({ text });
const b = (text: string): Run => ({ text, bold: true });
const a = (href: string, text: string): Run => ({ text, href });
const para = (...runs: Run[]): Block => ({ type: 'para', runs });
const cross = (...items: string[]): Block => ({ type: 'cross', items });
const check = (...items: string[]): Block => ({ type: 'check', items });
const steps = (...items: string[]): Block => ({ type: 'steps', items });
const cards = (...items: [string, string][]): Block => ({ type: 'cards', items });

const badges = [
  { label: 'Notes Not Retained', color: '#147a5c', icon: '<path d="M12 3 4 6v6c0 5 3.4 8.4 8 9 4.6-.6 8-4 8-9V6z"></path><path d="m9 12 2 2 4-4"></path>' },
  { label: 'Encrypted in Transit', color: '#2A73C7', icon: '<rect x="4" y="10" width="16" height="10" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path>' },
  { label: 'No Data Selling', color: '#b4232a', icon: '<circle cx="12" cy="12" r="9"></circle><path d="m5.6 5.6 12.8 12.8"></path>' },
  { label: 'HIPAA Compliant', color: '#b8730c', icon: '<path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"></path><rect x="9" y="3" width="6" height="4" rx="1"></rect>' },
];

const sections: { n: string; title: string; blocks: Block[] }[] = [
  { n: '01', title: 'Who We Are', blocks: [
    para(t('Note Reviewer is a browser extension developed and maintained by '), b('Infinity Code LLC'),
      t(', a technology company dedicated to building productivity tools for healthcare professionals. Our secure API infrastructure is hosted at '),
      a('https://infinitycodellc.com', 'infinitycodellc.com'), t('.')),
    para(t('If you have any questions about this Privacy Policy, please contact us at '),
      a('mailto:info@notereviewer.org', 'info@notereviewer.org'), t('.')),
  ]},

  { n: '02', title: 'What Data We Process', blocks: [
    para(t('When you use Note Reviewer, the extension reads the '), b('clinical note text'),
      t(' visible on your active browser tab — only when you explicitly trigger the analysis by activating the side panel. This text may include session descriptions, behavioral observations, and goal progress notes authored by BCBAs.')),
    para(t('If you choose to use the Management Panel, the extension also processes the '), b('treatment plan documents you upload'),
      t(' — BIPs and assessments — to build the client records used to check notes against the plan. Uploading is optional; reviews run without it.')),
    para(t('We do '), b('not'), t(' collect or process:')),
    cross(
      'Social Security Numbers, insurance IDs, or financial information.',
      'Photographs, audio recordings, or biometric data.',
      'Your browsing history outside of the active note analysis session.',
    ),
  ]},

  { n: '03', title: 'How We Use Your Data', blocks: [
    para(t('The note text you submit is used '), b('solely'), t(' to generate real-time quality and compliance suggestions. The processing pipeline is as follows:')),
    steps(
      'You activate the Note Reviewer side panel and submit a note for review.',
      'The extension encrypts the text and sends it over HTTPS/TLS to our secure API endpoint at infinitycodellc.com.',
      'The AI model analyzes the note for clinical quality, objectivity, measurability, and ABA compliance standards.',
      'Suggestions are returned to your browser and displayed in the side panel.',
      'The submitted text is immediately discarded from our servers — it is never written to a database or log file.',
    ),
  ]},

  { n: '04', title: 'Data Storage & Retention', blocks: [
    para(b('We do not store clinical note content on our servers.'),
      t(' After the AI analysis is complete and the response is sent back to your browser, all submitted text is discarded from memory and is not persisted in any database, file system, or log.')),
    para(t('Client records you create in the Management Panel — the treatment plan data extracted from documents you upload — are retained under your account so reviews can be checked against the plan, and remain available for you to edit or delete at any time. '),
      b('[Placeholder — confirm retention period and deletion policy with legal.]')),
    para(t('Your '), b('API key'),
      t(" — required to authenticate with the AI provider — is stored exclusively in your browser's local storage using the browser Extension Storage API. It never leaves your device and is never transmitted to our servers.")),
    para(t('We may retain '), b('anonymized, aggregate usage metrics'),
      t(' (e.g., number of analyses performed per day) for the sole purpose of monitoring service reliability. These metrics contain no content from your notes.')),
  ]},

  { n: '05', title: 'Security Measures', blocks: [
    para(t('We implement industry-standard security controls to protect the data you submit:')),
    cards(
      ['Encryption in transit:', 'All communication between the extension and our API uses TLS 1.2+ (HTTPS), preventing eavesdropping or interception.'],
      ['Secure infrastructure:', 'Our API is hosted on enterprise-grade cloud infrastructure with restricted access, firewall protection, and regular security audits.'],
      ['Minimal data exposure:', 'By design, we process the smallest amount of data necessary to fulfill the analysis request and discard it immediately after.'],
    ),
  ]},

  { n: '06', title: 'Third-Party Sharing', blocks: [
    para(b('We do not sell, rent, or share your data with third parties for advertising, marketing, or any commercial purpose.')),
    para(t("The note text you submit is processed by the AI model provider that you configure via your API key. That provider's own privacy policy and terms of service govern their handling of data. We strongly recommend reviewing the privacy documentation of your chosen AI provider.")),
    para(t('We may disclose data only if required by law, court order, or to protect the rights and safety of our users — and solely to the minimum extent necessary.')),
  ]},

  { n: '07', title: 'HIPAA Compliance', blocks: [
    para(b('Note Reviewer is HIPAA compliant.'),
      t(' The extension is built to the Privacy, Security, and Breach Notification Rules, and is designed to assist BCBAs in improving the quality of their documentation without placing Protected Health Information at risk.')),
    para(t('Our compliance rests on the architecture itself: note content is not logged or persisted beyond the immediate processing window, your API key never leaves your browser, all traffic is encrypted in transit via TLS, and your original notes are never modified.')),
    para(t('If your organization requires a Business Associate Agreement (BAA), please contact us at '),
      a('mailto:info@notereviewer.org', 'info@notereviewer.org'), t(' to discuss your needs.')),
  ]},

  { n: '08', title: 'Your Rights', blocks: [
    para(t('You have the right to:')),
    check(
      'Request confirmation of whether we hold any personal data about you.',
      'Request access to, correction of, or deletion of the client records you have created.',
      'Withdraw consent for processing at any time by uninstalling the extension.',
      'Lodge a complaint with the relevant data protection authority in your jurisdiction.',
    ),
    para(t('To exercise any of these rights, contact us at '),
      a('mailto:info@notereviewer.org', 'info@notereviewer.org'), t('.')),
  ]},

  { n: '09', title: 'Changes to This Policy', blocks: [
    para(t('We may update this Privacy Policy from time to time to reflect changes in our practices, technology, legal requirements, or other factors. When we make changes, we will update the "Last updated" date at the top of this page.')),
    para(t('We encourage you to review this page periodically. Continued use of the Note Reviewer extension after changes are posted constitutes your acceptance of the updated policy.')),
  ]},

  { n: '10', title: 'Contact Us', blocks: [
    para(t('If you have any questions, concerns, or requests related to this Privacy Policy, please reach out to us:')),
  ]},
];
---

<Layout
  title="Privacy Policy – Note Reviewer"
  description="Learn how Note Reviewer handles your data, protects patient privacy, and complies with HIPAA guidelines for clinical note analysis."
>
  <Navbar basePath="/" />

  <div class="bg-ink text-white">
    <div class="max-w-3xl mx-auto px-6 pt-17 pb-14 flex flex-col gap-3.5">
      <div class="font-mono text-[10px] tracking-[0.14em] uppercase text-ink-muted">Privacy Policy</div>
      <h1 class="m-0 text-[30px] md:text-[38px] font-semibold tracking-[-0.025em] leading-tight text-balance">
        We are committed to protecting the privacy of clinicians and the patients they document
      </h1>
      <p class="m-0 text-[15.5px] text-ink-soft leading-relaxed max-w-xl text-balance">
        Read how we handle data with the utmost care.
      </p>
      <div class="flex items-center gap-3 flex-wrap mt-2 font-mono text-[11px] text-ink-muted">
        <div>Last updated: {lastUpdated}</div>
        <div class="text-ink-line">·</div>
        <div>Infinity Code LLC</div>
      </div>
    </div>
  </div>

  <div class="bg-panel border-b border-panel-line">
    <div class="max-w-6xl mx-auto px-6 py-5.5 flex gap-2.5 flex-wrap justify-center">
      {badges.map(({ label, color, icon }) => (
        <div class="flex items-center gap-2.5 bg-white border border-[#dfe7f1] rounded-[10px] px-4 py-2.5">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke={color} stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
          <div class="text-[13px] font-medium">{label}</div>
        </div>
      ))}
    </div>
  </div>

  <main class="max-w-3xl mx-auto px-6 pt-14 pb-5 flex flex-col gap-11">

    <div class="flex gap-3.5 p-5 border border-accent-line bg-panel rounded-xl">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2A73C7" stroke-width="1.9" stroke-linecap="round" class="shrink-0 mt-0.5"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5M12 8h.01"></path></svg>
      <p class="m-0 text-sm text-[#3d5170] leading-relaxed text-balance">
        <span class="font-semibold text-ink">Plain-language summary:</span> Note Reviewer reads the clinical note text you provide, sends it to a secure AI API for analysis, returns quality suggestions to you, and then discards the content. We do not sell or share your data or your patients' Protected Health Information (PHI).
      </p>
    </div>

    {sections.map(({ n, title, blocks }) => (
      <div class="flex flex-col gap-3.5">
        <div class="flex items-center gap-3">
          <div class="w-[30px] h-[30px] rounded-lg bg-accent-bg text-accent font-mono text-xs font-medium flex items-center justify-center shrink-0">{n}</div>
          <h2 class="m-0 text-[19px] font-semibold tracking-[-0.015em] leading-snug text-balance">{title}</h2>
        </div>

        <div class="pl-10.5 flex flex-col gap-3.5">
          {blocks.map((block) => (
            <>
              {block.type === 'para' && (
                <p class="m-0 text-sm text-slate leading-[1.75] text-balance">
                  {block.runs.map((r) => (
                    r.href
                      ? <a href={r.href} target={r.href.startsWith('http') ? '_blank' : undefined} rel={r.href.startsWith('http') ? 'noopener' : undefined}>{r.text}</a>
                      : <span class={r.bold ? 'text-ink font-semibold' : ''}>{r.text}</span>
                  ))}
                </p>
              )}

              {block.type === 'cross' && (
                <div class="flex flex-col gap-2">
                  {block.items.map((text) => (
                    <div class="flex gap-2.5 items-start">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#c86a6f" stroke-width="2.4" stroke-linecap="round" class="shrink-0 mt-1"><path d="M18 6 6 18M6 6l12 12"></path></svg>
                      <div class="text-sm text-slate leading-relaxed">{text}</div>
                    </div>
                  ))}
                </div>
              )}

              {block.type === 'check' && (
                <div class="flex flex-col gap-2">
                  {block.items.map((text) => (
                    <div class="flex gap-2.5 items-start">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#147a5c" stroke-width="2.4" stroke-linecap="round" class="shrink-0 mt-1"><path d="M20 6 9 17l-5-5"></path></svg>
                      <div class="text-sm text-slate leading-relaxed">{text}</div>
                    </div>
                  ))}
                </div>
              )}

              {block.type === 'steps' && (
                <div class="flex flex-col gap-2.5">
                  {block.items.map((text, i) => (
                    <div class="flex gap-3 items-start">
                      <div class="w-[22px] h-[22px] rounded-full bg-accent text-white font-mono text-[10.5px] flex items-center justify-center shrink-0 mt-0.5">{i + 1}</div>
                      <div class="text-sm text-slate leading-relaxed">{text}</div>
                    </div>
                  ))}
                </div>
              )}

              {block.type === 'cards' && (
                <div class="flex flex-col gap-2">
                  {block.items.map(([cardTitle, text]) => (
                    <div class="flex gap-2.5 items-start p-3.5 bg-[#f6f8fb] border border-line rounded-[10px]">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2A73C7" stroke-width="1.9" stroke-linecap="round" class="shrink-0 mt-0.5"><rect x="4" y="10" width="16" height="10" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg>
                      <div class="text-sm text-slate leading-relaxed"><span class="text-ink font-semibold">{cardTitle}</span> {text}</div>
                    </div>
                  ))}
                </div>
              )}
            </>
          ))}
        </div>
      </div>
    ))}

    <div class="border border-line bg-white rounded-xl p-6 flex flex-col gap-3.5">
      <div class="text-[15px] font-semibold tracking-[-0.01em]">Infinity Code LLC</div>
      <div class="flex flex-col gap-2.5">
        <div class="flex items-center gap-2.5">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2A73C7" stroke-width="1.8" stroke-linecap="round" class="shrink-0"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
          <a href="mailto:info@notereviewer.org" class="text-[13.5px]">info@notereviewer.org</a>
        </div>
        <div class="flex items-center gap-2.5">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#147a5c" stroke-width="1.8" stroke-linecap="round" class="shrink-0"><path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20.5l1.8-5.2A8.4 8.4 0 1 1 21 11.5z"></path></svg>
          <a href="https://wa.me/17866447422" target="_blank" rel="noopener" class="text-[13.5px] text-ink">+1 786-644-7422 (WhatsApp)</a>
        </div>
        <div class="flex items-center gap-2.5">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8695aa" stroke-width="1.8" stroke-linecap="round" class="shrink-0"><path d="M4 21V6l8-3 8 3v15"></path><path d="M9 21v-6h6v6"></path></svg>
          <a href="https://infinitycodellc.com" target="_blank" rel="noopener" class="text-[13.5px]">infinitycodellc.com</a>
        </div>
      </div>
    </div>

    <div class="flex justify-center pb-5">
      <a href="/" class="flex items-center gap-2 text-[13.5px] font-medium text-ink hover:text-accent transition-colors">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 12H5M11 18l-6-6 6-6"></path></svg>
        Back to Note Reviewer Home
      </a>
    </div>
  </main>

  <Footer />
</Layout>
