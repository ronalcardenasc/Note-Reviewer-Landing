---
import BrowserStores from './BrowserStores.astro';
---

<section class="max-w-6xl mx-auto px-6 pb-18">
  <div class="border border-accent-line rounded-2xl p-9 md:p-11 flex flex-col items-center gap-4 text-center" style="background: linear-gradient(160deg, #f4f8fd 0%, #eaf1fa 100%);">
    <h2 class="m-0 text-2xl md:text-[28px] font-semibold tracking-[-0.02em] leading-tight max-w-xl text-balance">
      Ready to elevate your clinical documentation?
    </h2>
    <p class="m-0 text-[14.5px] text-slate leading-relaxed max-w-xl text-balance">
      Join ABA professionals who trust Note Reviewer for faster, higher-quality notes — every session.
      Available on Chrome, Edge, Firefox, and Safari.
    </p>
    <div class="mt-1">
      <BrowserStores size="md" />
    </div>
  </div>
</section>
