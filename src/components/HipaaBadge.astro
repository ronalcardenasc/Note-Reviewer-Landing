---
interface Props {
  /** pill = compact rounded tag · card = icon + title + subtitle block */
  variant?: 'pill' | 'card';
  /** light = for dark backgrounds · dark = for light backgrounds */
  theme?: 'light' | 'dark';
  /** Optional supporting line, rendered under the label on the card variant */
  note?: string;
  class?: string;
}

const { variant = 'pill', theme = 'dark', note = 'BAA available on request', class: className = '' } = Astro.props;

const shieldPath = 'M12 3 4 6v6c0 5 3.4 8.4 8 9 4.6-.6 8-4 8-9V6z';
const checkPath = 'm9 12 2 2 4-4';
---

{variant === 'pill' && (
  <span
    class:list={[
      'inline-flex items-center gap-1.5 font-mono text-[10.5px] tracking-[0.08em] uppercase px-2.5 py-1 rounded-full border',
      theme === 'light'
        ? 'text-[#7ec8ac] border-[#235844] bg-[rgba(20,122,92,0.16)]'
        : 'text-green border-green-line bg-green-bg',
      className,
    ]}
  >
    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
      <path d={shieldPath}></path>
      <path d={checkPath}></path>
    </svg>
    HIPAA Compliant
  </span>
)}

{variant === 'card' && (
  <div class:list={['flex items-center gap-3 p-3.5 rounded-[10px] border border-green-line bg-[#f2faf6]', className]}>
    <div class="w-10 h-10 rounded-[11px] bg-[#e0f0e8] flex items-center justify-center shrink-0">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#147a5c" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
        <path d={shieldPath}></path>
        <path d={checkPath}></path>
      </svg>
    </div>
    <div class="flex flex-col gap-0.5">
      <div class="text-sm font-semibold text-[#0f5d47]">HIPAA Compliant</div>
      {note && <div class="text-xs text-[#3d7a68]">{note}</div>}
    </div>
  </div>
)}
