---
interface Props {
  /** pill = compact rounded tag · seal = large circular emblem · inline = text + icon on one line */
  variant?: 'pill' | 'seal' | 'inline';
  /** light = for dark backgrounds · dark = for light backgrounds */
  theme?: 'light' | 'dark';
  /** Optional supporting line, rendered under the label on the seal variant */
  note?: string;
  class?: string;
}

const { variant = 'pill', theme = 'light', note, class: className = '' } = Astro.props;

const shieldPath = 'M12 2.5 4.5 5.6v5.6c0 4.7 3.2 9.1 7.5 10.3 4.3-1.2 7.5-5.6 7.5-10.3V5.6L12 2.5Z';
const checkPath = 'm8.6 12.1 2.3 2.3 4.5-4.6';
---

{variant === 'pill' && (
  <span
    class={`inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest px-4 py-1.5 rounded-full ${
      theme === 'light'
        ? 'bg-white/15 border border-white/25 text-white/90'
        : 'bg-emerald-50 border border-emerald-200 text-emerald-800'
    } ${className}`}
  >
    <svg class={`w-4 h-4 shrink-0 ${theme === 'light' ? 'text-emerald-400' : 'text-emerald-600'}`} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d={shieldPath} fill="currentColor" opacity="0.18" />
      <path d={shieldPath} stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
      <path d={checkPath} stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    HIPAA Compliant
  </span>
)}

{variant === 'inline' && (
  <span class={`inline-flex items-center gap-2 ${theme === 'light' ? 'text-white/90' : 'text-slate-700'} ${className}`}>
    <svg class={`w-4 h-4 shrink-0 ${theme === 'light' ? 'text-emerald-400' : 'text-emerald-600'}`} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d={shieldPath} fill="currentColor" opacity="0.18" />
      <path d={shieldPath} stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
      <path d={checkPath} stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span class="text-sm font-semibold">HIPAA Compliant</span>
  </span>
)}

{variant === 'seal' && (
  <div
    class={`hipaa-seal inline-flex flex-col items-center justify-center text-center rounded-full shrink-0 ${
      theme === 'light'
        ? 'bg-white/10 border-2 border-emerald-400/50 text-white'
        : 'bg-white border-2 border-emerald-500/40 text-slate-800 shadow-sm'
    } ${className}`}
    role="img"
    aria-label={`HIPAA Compliant${note ? ` — ${note}` : ''}`}
  >
    <svg
      class={`w-11 h-11 mb-1 ${theme === 'light' ? 'text-emerald-400' : 'text-emerald-600'}`}
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path d={shieldPath} fill="currentColor" opacity="0.18" />
      <path d={shieldPath} stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
      <path d={checkPath} stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span class="text-[13px] font-extrabold uppercase tracking-widest leading-none">HIPAA</span>
    <span class={`text-[10px] font-bold uppercase tracking-[0.2em] leading-none mt-1 ${theme === 'light' ? 'text-emerald-300' : 'text-emerald-700'}`}>
      Compliant
    </span>
    {note && (
      <span class={`text-[9px] font-medium tracking-wide leading-tight mt-1.5 px-4 ${theme === 'light' ? 'text-white/60' : 'text-slate-500'}`}>
        {note}
      </span>
    )}
  </div>
)}

<style>
  .hipaa-seal {
    width: 150px;
    height: 150px;
  }

  @media (max-width: 480px) {
    .hipaa-seal {
      width: 128px;
      height: 128px;
    }
  }
</style>
