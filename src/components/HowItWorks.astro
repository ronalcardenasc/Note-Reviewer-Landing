---
const steps = [
  { n: '01', title: 'Install the Extension', body: 'Add Note Reviewer to your browser from your preferred store with one click. No account required to get started.' },
  { n: '02', title: 'Enter Your API Key', body: 'Connect your own AI API key. Your key stays in your browser — we never store or access it on our servers.' },
  { n: '03', optional: true, title: 'Set Up Your Clients', body: "Upload each client's BIP or assessment in the Management Panel so reviews can be checked against the treatment plan. Skip it and notes are still reviewed on their own." },
  { n: '04', title: 'Review Your Notes', body: 'Open any clinical note, activate the side panel, and receive immediate AI-powered quality and compliance suggestions.' },
];
---

<section id="how-it-works" class="bg-ink text-white">
  <div class="max-w-6xl mx-auto px-6 py-18 flex flex-col gap-7">
    <div class="flex flex-col gap-2 max-w-xl">
      <div class="font-mono text-[10px] tracking-[0.14em] uppercase text-ink-muted">How it works</div>
      <h2 class="m-0 text-[26px] md:text-[30px] font-semibold tracking-[-0.02em] leading-tight">
        Four steps, no account required.
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {steps.map(({ n, title, body, optional }) => (
        <div class="border border-ink-line rounded-xl p-5.5 flex flex-col gap-3 bg-white/[0.03]">
          <div class="flex items-center gap-2">
            <div class="font-mono text-[11px] text-accent tracking-[0.1em]">{n}</div>
            {optional && (
              <div class="font-mono text-[8.5px] tracking-[0.1em] uppercase text-ink-soft border border-ink-line px-1.5 py-0.5 rounded-full">optional</div>
            )}
          </div>
          <div class="text-base font-semibold tracking-[-0.01em]">{title}</div>
          <div class="text-[13.5px] text-ink-soft leading-relaxed text-balance">{body}</div>
        </div>
      ))}
    </div>
  </div>
</section>
