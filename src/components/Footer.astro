---
import BrowserStores from './BrowserStores.astro';
import HipaaBadge from './HipaaBadge.astro';

const currentPath = Astro.url.pathname;
const base = currentPath === '/' ? '' : '/';
---

<footer id="contact" class="bg-ink text-white">
  <div class="max-w-6xl mx-auto px-6 pt-12 pb-6.5 grid sm:grid-cols-3 gap-8.5">

    <div class="flex flex-col gap-3">
      <div class="flex items-center gap-2.5">
        <img src="/favicon.svg" alt="Note Reviewer" class="w-[26px] h-[26px] rounded-[7px]" />
        <div class="text-[14.5px] font-semibold">Note Reviewer</div>
      </div>
      <div class="text-[12.5px] text-ink-soft leading-relaxed max-w-[300px]">
        AI-powered quality and compliance review for ABA clinical notes, right inside your browser.
      </div>
      <HipaaBadge variant="pill" theme="light" class="self-start" />
      <BrowserStores variant="text" />
    </div>

    <div class="flex flex-col gap-2.5">
      <div class="font-mono text-[10px] tracking-[0.14em] uppercase text-ink-muted">Product</div>
      <a href={`${base}#features`} class="text-[13px] text-ink-faint hover:text-white transition-colors">Features</a>
      <a href={`${base}#how-it-works`} class="text-[13px] text-ink-faint hover:text-white transition-colors">How it Works</a>
      <a href="/privacy" class="text-[13px] text-ink-faint hover:text-white transition-colors">Privacy Policy</a>
    </div>

    <div class="flex flex-col gap-2.5">
      <div class="font-mono text-[10px] tracking-[0.14em] uppercase text-ink-muted">Support</div>
      <a href="mailto:info@notereviewer.org" class="flex items-center gap-2 text-[13px] text-ink-faint hover:text-white transition-colors">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="shrink-0"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
        info@notereviewer.org
      </a>
      <a href="https://wa.me/17866447422" target="_blank" rel="noopener" class="flex items-center gap-2 text-[13px] text-ink-faint hover:text-white transition-colors">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="shrink-0"><path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20.5l1.8-5.2A8.4 8.4 0 1 1 21 11.5z"></path></svg>
        WhatsApp · +1 786-644-7422
      </a>
    </div>
  </div>

  <div class="border-t border-[#1c3357]">
    <div class="max-w-6xl mx-auto px-6 py-4 flex gap-3.5 flex-wrap items-center">
      <div class="text-[11.5px] text-ink-muted">© {new Date().getFullYear()} Infinity Code LLC. All rights reserved.</div>
      <div class="text-[11.5px] text-ink-muted ml-auto">Note Reviewer is not affiliated with any EHR provider.</div>
    </div>
  </div>
</footer>
