---
interface Props {
  basePath?: string;
}
const { basePath = '' } = Astro.props;
---

<header class="sticky top-0 z-50 bg-surface/92 backdrop-blur-md border-b border-line">
  <div class="max-w-6xl mx-auto px-6 h-[62px] flex items-center gap-4">
    <a href={basePath || '/'} class="flex items-center gap-2.5 group shrink-0">
      <img src="/favicon.svg" alt="Note Reviewer" class="w-[26px] h-[26px] rounded-[7px] group-hover:animate-spin-slow transition-transform" />
      <span class="font-semibold text-ink text-[14.5px] tracking-tight">Note Reviewer</span>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-[13.5px] text-slate ml-auto">
      <a href={`${basePath}#features`}     class="hover:text-ink transition-colors">Features</a>
      <a href={`${basePath}#management`}   class="hover:text-ink transition-colors">Management</a>
      <a href={`${basePath}#how-it-works`} class="hover:text-ink transition-colors">How it Works</a>
      <a href={`${basePath}#privacy`}      class="hover:text-ink transition-colors">Privacy</a>
      <a href={`${basePath}#contact`}      class="hover:text-ink transition-colors">Contact</a>
    </nav>

    <a
      href={`${basePath}#install`}
      class="ml-4 md:ml-0 inline-flex items-center gap-2 bg-ink hover:bg-ink-2 text-white text-[13px] font-medium px-4 py-2.5 rounded-[8px] transition-colors shrink-0"
    >
      Get Started
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
        <path d="M5 12h14M13 6l6 6-6 6"/>
      </svg>
    </a>
  </div>
</header>
