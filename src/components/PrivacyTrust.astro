---
import HipaaBadge from './HipaaBadge.astro';

const trust = [
  'HIPAA compliant — BAA available on request',
  'Your API key is stored locally in your browser only',
  'Data is encrypted in transit via HTTPS / TLS',
  'Original notes are never modified by the extension',
];
---

<section id="privacy" class="max-w-6xl mx-auto px-6 py-18 grid sm:grid-cols-2 gap-10 items-start">
  <div class="flex flex-col gap-3.5">
    <div class="font-mono text-[10px] tracking-[0.14em] uppercase text-slate-2">Privacy &amp; Trust</div>
    <h2 class="m-0 text-[26px] md:text-[30px] font-semibold tracking-[-0.02em] leading-tight text-balance">
      Your patients' data stays private. Always.
    </h2>
    <p class="m-0 text-[14.5px] text-slate leading-relaxed text-balance">
      Note Reviewer is HIPAA compliant and built with privacy-first architecture. Note content is processed for the review and then discarded, your API key never leaves your browser, and anything you do save stays under your control.
    </p>
    <HipaaBadge variant="card" />
    <a href="/privacy" class="text-[13.5px] text-accent">Read our privacy policy →</a>
  </div>

  <div class="flex flex-col gap-2.5">
    {trust.map((text) => (
      <div class="flex gap-2.5 items-start p-3.5 border border-line rounded-[10px] bg-white">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#147a5c" stroke-width="2.4" stroke-linecap="round" class="shrink-0 mt-0.5"><path d="M20 6 9 17l-5-5"></path></svg>
        <div class="text-[13.5px] text-ink leading-relaxed">{text}</div>
      </div>
    ))}
  </div>
</section>
