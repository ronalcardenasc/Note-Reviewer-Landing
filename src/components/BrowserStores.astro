---
interface Props {
  label?: string;
  size?: 'sm' | 'md';
  /** button = full mark + name button · text = plain text pill (used in the footer) */
  variant?: 'button' | 'text';
}
const { label = '', size = 'md', variant = 'button' } = Astro.props;

const stores = [
  {
    name: 'Chrome',
    note: 'Web Store',
    initial: 'C',
    href: 'https://chromewebstore.google.com/detail/note-reviewer/fmfahaplknplobmakjodeiajiaaipooo',
    markBg: 'bg-accent-bg',
    markColor: 'text-accent',
  },
  {
    name: 'Edge',
    note: 'Add-ons',
    initial: 'E',
    href: 'https://microsoftedge.microsoft.com/addons/detail/revisor-de-notas/kkcpnonhggddljkjilcdkiapjihlanfh',
    markBg: 'bg-[#e9f2f7]',
    markColor: 'text-cyan',
  },
  {
    name: 'Firefox',
    note: 'Add-ons',
    initial: 'F',
    href: 'https://addons.mozilla.org/es-ES/firefox/addon/note-reviewer/?utm_source=addons.mozilla.org&utm_medium=referral&utm_content=search',
    markBg: 'bg-amber-bg',
    markColor: 'text-amber',
  },
  {
    name: 'Safari',
    note: 'Coming soon',
    initial: 'S',
    href: '#install',
    markBg: 'bg-[#f0f4f9]',
    markColor: 'text-slate-2',
    soon: true,
  },
];

const markSize = size === 'sm' ? 'w-[20px] h-[20px] text-[10px]' : 'w-[22px] h-[22px] text-[11px]';
const btnPad = size === 'sm' ? 'px-3 py-2' : 'px-3.5 py-2.5';
---

{variant === 'text' ? (
  <div class="flex flex-wrap gap-1.5">
    {stores.map(({ name, href, soon }) => (
      soon ? (
        <span class="font-mono text-[11.5px] text-ink-soft/50 border border-ink-line/60 px-2.5 py-1 rounded-[7px]">{name}</span>
      ) : (
        <a href={href} target="_blank" rel="noopener noreferrer" class="font-mono text-[11.5px] text-ink-faint border border-ink-line px-2.5 py-1 rounded-[7px] hover:text-white hover:no-underline transition-colors">{name}</a>
      )
    ))}
  </div>
) : (
  <div class="w-full">
    {label && (
      <p class="text-center font-mono text-[10px] tracking-[0.12em] uppercase text-slate-2 mb-3">{label}</p>
    )}
    <div class="flex flex-wrap justify-center gap-2.5">
      {stores.map(({ name, note, initial, href, markBg, markColor, soon }) => (
        soon ? (
          <span
            class:list={['flex items-center gap-2.5 rounded-[10px] border border-line bg-surface-2/60 text-slate-3 cursor-default select-none', btnPad]}
            title={`${name} — Coming Soon`}
          >
            <span class:list={['rounded-[6px] flex items-center justify-center font-mono font-medium shrink-0', markSize, markBg, markColor]}>{initial}</span>
            <span class="flex flex-col items-start leading-tight">
              <span class="text-[13px] font-medium">{name}</span>
              <span class="font-mono text-[9px] tracking-[0.06em] uppercase text-slate-2">{note}</span>
            </span>
          </span>
        ) : (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class:list={['flex items-center gap-2.5 rounded-[10px] border border-line bg-white text-ink hover:border-accent hover:no-underline transition-colors', btnPad]}
          >
            <span class:list={['rounded-[6px] flex items-center justify-center font-mono font-medium shrink-0', markSize, markBg, markColor]}>{initial}</span>
            <span class="flex flex-col items-start leading-tight">
              <span class="text-[13px] font-medium">{name}</span>
              <span class="font-mono text-[9px] tracking-[0.06em] uppercase text-slate-2">{note}</span>
            </span>
          </a>
        )
      ))}
    </div>
  </div>
)}
