---
const features = [
  {
    title: 'Smart Sidebar',
    body: "Clinical suggestions appear in your browser's built-in side panel — right next to your work, without interrupting your documentation flow or altering the source text.",
    paths: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M15 4v16"/>',
  },
  {
    title: 'Clinical Precision',
    body: 'AI trained on ABA compliance standards and best practices. Get targeted feedback on objectivity, measurability, and regulatory requirements specific to behavior analysis.',
    paths: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>',
  },
  {
    title: 'Instant Feedback',
    body: "Results in seconds. Save valuable administrative time and reduce rework — so you can focus on what matters most: your clients' progress and outcomes.",
    paths: '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
  },
];
---

<section id="features" class="max-w-6xl mx-auto px-6 py-18 flex flex-col gap-7">
  <div class="flex flex-col gap-2 max-w-xl">
    <div class="font-mono text-[10px] tracking-[0.14em] uppercase text-slate-2">Features</div>
    <h2 class="m-0 text-[26px] md:text-[30px] font-semibold tracking-[-0.02em] leading-tight">
      Built for the way BCBAs actually document.
    </h2>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {features.map(({ title, body, paths }) => (
      <div class="border border-line rounded-xl bg-white p-5.5 flex flex-col gap-3">
        <div class="w-[34px] h-[34px] rounded-[9px] bg-accent-bg flex items-center justify-center">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2A73C7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={paths} />
        </div>
        <div class="text-base font-semibold tracking-[-0.01em]">{title}</div>
        <div class="text-[13.5px] text-slate leading-relaxed text-balance">{body}</div>
      </div>
    ))}
  </div>
</section>
